# Bullseye Offense environment variables.
# Copy to .env.local for local development. Configure in your Vercel
# project's Environment Variables panel for the deployed site.

# Shared password gating access to the app. Anyone with this password
# can sign in; the unlock state persists in localStorage. For internal
# sales-team use, treat this like a Wi-Fi password — share it via Slack
# DM or 1Password, not in public docs.
#
# Dev fallback: when this var is undefined and `npm run dev` is running
# locally, the password defaults to "bullseye-dev" so local development
# works out of the box. In production builds, an undefined value shows
# a configuration-error screen instead of silently allowing access.
VITE_APP_PASSWORD=change-me-before-shipping

# Supabase shared backend — used to sync sent-history and customer notes
# across team members in realtime. Both vars must be set together; if either
# is missing the app falls back to local-only mode (data stays in IndexedDB
# per browser, no team sharing). Useful for local dev without a Supabase
# project, or as a defensive fallback if the backend is unreachable.
#
# Get these from Supabase Dashboard → your project → Settings → API:
#   - VITE_SUPABASE_URL: "Project URL" (looks like https://abcxyz.supabase.co)
#   - VITE_SUPABASE_ANON_KEY: "anon public" key (long JWT)
#
# Schema lives in supabase/schema.sql — paste it into Supabase's SQL editor
# once when bootstrapping a new project.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
